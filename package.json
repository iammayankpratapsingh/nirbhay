{
  "name": "nirbhay-pen-battle",
  "version": "1.0.0",
  "description": "Nirbhay: Pen Battle — tabletop pen fighting in the browser",
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:next": "next dev",
    "build": "next build && npm run build:server",
    "build:server": "esbuild server/index.ts server/standalone.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --out-extension:.js=.mjs",
    "start": "NODE_ENV=production node dist/index.mjs",
    "start:multiplayer": "NODE_ENV=production node dist/standalone.mjs",
    "dev:multiplayer": "tsx --env-file-if-exists=.env.local server/standalone.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "zip": "node scripts/zip.mjs",
    "e2e": "node tests/e2e/browser.mjs"
  },
  "type": "module",
  "dependencies": {
    "matter-js": "^0.20.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
